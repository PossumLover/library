---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <time class="post-date" datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
    <h1 class="post-title">{{ title }}</h1>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  <div class="post-source">
    <a href="https://samkriss.substack.com/p/{{ slug }}" class="source-link" target="_blank" rel="noopener">
      Read on Substack ↗
    </a>
  </div>
</article>

<nav class="post-nav">
  <a href="/" class="back-link">← All articles</a>
</nav>
