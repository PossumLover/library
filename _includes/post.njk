---
layout: base.njk
---
<article class="post" data-pagefind-body>
  <header class="post-header">
    <time class="post-date" datetime="{{ date | htmlDateString }}" data-pagefind-meta="date" data-pagefind-ignore>{{ date | readableDate }}</time>
    <h1 class="post-title" data-pagefind-meta="title">{{ title }}</h1>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  <div class="post-source" data-pagefind-ignore>
    <a href="https://samkriss.substack.com/p/{{ slug }}" class="source-link" target="_blank" rel="noopener">
      Read on Substack ↗
    </a>
  </div>
</article>

<nav class="post-nav">
  <a href="/" class="back-link">← All articles</a>
</nav>
